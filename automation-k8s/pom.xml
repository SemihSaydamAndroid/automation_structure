<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.semihsaydamandroid</groupId>
        <artifactId>automation-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>automation-k8s</artifactId>
    <name>Automation :: Kubernetes</name>
    <description>
        Kubernetes-native execution: on-demand browser pods for Selenium sessions and a remote runner
        that executes a local project inside the cluster, isolated per profile (local / ci).
    </description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>automation-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-client</artifactId>
        </dependency>
        <!-- Needed by fabric8 for copying files/directories to and from pods. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
        </dependency>

        <!-- Optional: only needed when the Selenium integration (KubernetesDriverProvider) is used. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>automation-ui</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Optional: only needed for distributed JMeter load tests (DistributedLoadTest). -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>automation-perf</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
